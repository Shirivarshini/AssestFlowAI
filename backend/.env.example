# Implementation choice: PostgreSQL per 03_ARCHITECTURE.md.
# Local docker-compose (see backend/docker-compose.yml) provisions this exact DB.
DATABASE_URL=postgresql+psycopg2://assetflow:assetflow@localhost:5432/assetflow

# API prefix (matches 04_API_CONTRACT.md: /api/v1)
API_PREFIX=/api/v1

# CORS origin for Member 1's frontend dev server (implementation default, adjust as needed)
FRONTEND_ORIGIN=http://localhost:5173
